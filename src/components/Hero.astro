---
import { AFFILIATE_URL } from '../data/plans';
import CatIllustration from './CatIllustration.astro';
---

<section class="hero-section">
  <div class="container hero-inner">
    <!-- Left Asymmetric Magazine Content -->
    <div class="hero-content">
      <div class="hero-issue-badge">
        <span class="issue-tag">KENDEJI ONLINE</span>
        <span class="issue-date">2026 OFFICIAL EDITION</span>
      </div>

      <h1 class="hero-title">
        肯の基 Kendeji
        <span class="title-sub font-serif">套餐详情与订阅使用手册</span>
      </h1>

      <p class="hero-subtitle">
        了解肯の基公开参考套餐、线路基础知识及常见故障处理，帮助新用户在订阅前了解重要信息。
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="#plans" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          查看套餐详情
        </a>
        <a 
          href={AFFILIATE_URL}
          target="_blank" 
          rel="sponsored nofollow noopener"
          class="btn btn-secondary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          前往订阅开通
        </a>
      </div>
    </div>

    <!-- Right Side SVG Cat & Geometry Graphic -->
    <div class="hero-graphic">
      <CatIllustration />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 4rem;
    padding-bottom: 4.5rem;
    background-color: var(--bg-cream);
    border-bottom: 2px solid var(--color-cocoa);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-issue-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.3rem 0.8rem;
    background-color: var(--color-apricot);
    border: 1.5px solid var(--color-cocoa);
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
    box-shadow: 2px 2px 0px var(--color-cocoa);
  }

  .issue-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-cocoa);
    letter-spacing: 0.05em;
  }

  .issue-date {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-orange);
  }

  .hero-title {
    font-size: 2.75rem;
    line-height: 1.15;
    color: var(--color-cocoa);
    font-weight: 900;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .title-sub {
    display: block;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-orange);
    margin-top: 0.4rem;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-graphic {
      order: -1;
    }

    .hero-title {
      font-size: 2.2rem;
    }

    .title-sub {
      font-size: 1.25rem;
    }
  }
</style>
