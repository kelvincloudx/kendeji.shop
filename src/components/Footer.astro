<footer class="site-footer">
  <div class="container footer-inner">
    <!-- Top Footer Columns -->
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <h3 class="footer-brand font-serif">肯の基 Kendeji</h3>
        <p class="brand-desc">
          专注于肯の基套餐资料整理、线路传输技术说明与单品牌服务介绍。
        </p>
        <div class="brand-tag-list">
          <span class="foot-tag">日系编辑刊目</span>
          <span class="foot-tag">单品牌聚焦</span>
        </div>
      </div>

      <!-- Col 2: Site Navigation -->
      <div class="footer-col">
        <h4 class="col-title font-serif">站点导航</h4>
        <ul class="footer-links">
          <li><a href="/#plans">7档参考套餐</a></li>
          <li><a href="/#tech">线路与技术说明</a></li>
          <li><a href="/#faq">常见问题 FAQ</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <div class="copyright-row">
        <span>&copy; {new Date().getFullYear()} 肯の基 Kendeji (kendeji.shop). All rights reserved.</span>
        <span>静态技术栈：Astro + TypeScript</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-cocoa);
    color: #FFF8EC;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    border-top: 3px solid var(--color-orange);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  .footer-brand {
    font-size: 1.6rem;
    color: #FFF8EC;
    margin-bottom: 0.75rem;
  }

  .brand-desc {
    font-size: 0.88rem;
    color: #E2D5C3;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 480px;
  }

  .brand-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .foot-tag {
    font-size: 0.72rem;
    background-color: rgba(255, 248, 236, 0.1);
    color: #FFF8EC;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(255, 248, 236, 0.2);
  }

  .col-title {
    font-size: 1.1rem;
    color: var(--color-apricot);
    margin-bottom: 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(255, 248, 236, 0.2);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.88rem;
    color: #E2D5C3;
    transition: color 0.2s;
    line-height: 1.4;
  }

  .footer-links a:hover {
    color: var(--color-orange);
  }

  /* Bottom Copyright */
  .footer-bottom {
    border-top: 1px solid rgba(255, 248, 236, 0.2);
    padding-top: 1.5rem;
  }

  .copyright-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: #A29583;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .copyright-row {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }
  }
</style>
