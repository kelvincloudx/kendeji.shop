---
---
<div class="cat-illustration-wrapper">
  <svg viewBox="0 0 500 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="cat-svg">
    <!-- Background Architectural Shapes -->
    <rect x="25" y="40" width="380" height="340" rx="16" fill="#F6DEB8" opacity="0.6"/>
    <circle cx="390" cy="90" r="70" fill="#809C83" opacity="0.5"/>
    <path d="M 50 380 L 450 380" stroke="#49382F" stroke-width="4" stroke-linecap="round"/>
    
    <!-- Abstract Sun / Geometry -->
    <circle cx="110" cy="110" r="50" fill="#F28C45"/>
    
    <!-- Arch Window element -->
    <path d="M 280 140 C 280 80, 360 80, 360 140 L 360 380 L 280 380 Z" fill="#FFF8EC" stroke="#49382F" stroke-width="3"/>
    
    <!-- Magazine Label Badge -->
    <g transform="translate(40, 60)">
      <rect x="0" y="0" width="130" height="28" rx="4" fill="#49382F"/>
      <text x="65" y="18" fill="#FFF8EC" font-family="Georgia, serif" font-size="11" font-weight="bold" text-anchor="middle" letter-spacing="1">KENDEJI EDIT</text>
    </g>

    <!-- Stylized Editorial Cat -->
    <!-- Cat Body -->
    <path d="M 170 380 Q 150 260 210 210 Q 270 260 250 380 Z" fill="#49382F"/>
    <path d="M 185 380 C 180 290, 220 270, 235 380 Z" fill="#F6DEB8"/>

    <!-- Cat Head & Ears -->
    <g transform="translate(210, 180)">
      <!-- Ears -->
      <polygon points="-35,-25 -15,-65 5,-30" fill="#49382F"/>
      <polygon points="-30,-28 -17,-55 -3,-32" fill="#F28C45"/>
      
      <polygon points="35,-25 15,-65 -5,-30" fill="#49382F"/>
      <polygon points="30,-28 17,-55 3,-32" fill="#F28C45"/>

      <!-- Head Circle -->
      <circle cx="0" cy="0" r="42" fill="#49382F"/>
      <circle cx="0" cy="2" r="38" fill="#FFF8EC"/>

      <!-- Eyes (Sleepy / Chic Editorial Style) -->
      <path d="M -22 -6 Q -12 -14 -2 -6" stroke="#49382F" stroke-width="3.5" stroke-linecap="round" fill="none"/>
      <path d="M 2 -6 Q 12 -14 22 -6" stroke="#49382F" stroke-width="3.5" stroke-linecap="round" fill="none"/>
      
      <!-- Cheeks -->
      <circle cx="-20" cy="6" r="6" fill="#F28C45" opacity="0.4"/>
      <circle cx="20" cy="6" r="6" fill="#F28C45" opacity="0.4"/>

      <!-- Nose & Mouth -->
      <polygon points="0,4 -5,-2 5,-2" fill="#F28C45"/>
      <path d="M 0 4 L 0 10 Q -6 16 -12 12 M 0 10 Q 6 16 12 12" stroke="#49382F" stroke-width="2.5" stroke-linecap="round" fill="none"/>

      <!-- Whiskers -->
      <line x1="-30" y1="4" x2="-52" y2="0" stroke="#49382F" stroke-width="2" stroke-linecap="round"/>
      <line x1="-30" y1="10" x2="-48" y2="12" stroke="#49382F" stroke-width="2" stroke-linecap="round"/>
      <line x1="30" y1="4" x2="52" y2="0" stroke="#49382F" stroke-width="2" stroke-linecap="round"/>
      <line x1="30" y1="10" x2="48" y2="12" stroke="#49382F" stroke-width="2" stroke-linecap="round"/>
    </g>

    <!-- Cat Tail -->
    <path d="M 245 350 Q 320 340 310 270 Q 300 240 280 250" stroke="#49382F" stroke-width="18" stroke-linecap="round" fill="none"/>
    <path d="M 245 350 Q 320 340 310 270 Q 300 240 280 250" stroke="#F6DEB8" stroke-width="8" stroke-linecap="round" fill="none"/>

    <!-- Decorative Floating Dessert (Napoleon Cake Piece) -->
    <g transform="translate(70, 280)">
      <rect x="0" y="20" width="65" height="35" rx="3" fill="#F28C45"/>
      <rect x="0" y="32" width="65" height="8" fill="#FFF8EC"/>
      <rect x="0" y="44" width="65" height="4" fill="#49382F"/>
      <!-- Cream Dollop -->
      <circle cx="20" cy="12" r="8" fill="#FFF8EC"/>
      <circle cx="35" cy="10" r="10" fill="#FFF8EC"/>
      <circle cx="50" cy="12" r="8" fill="#FFF8EC"/>
      <circle cx="35" cy="6" r="4" fill="#F28C45"/>
    </g>

    <!-- Stamp / Issue Badge -->
    <circle cx="420" cy="310" r="32" fill="#809C83" stroke="#49382F" stroke-width="2"/>
    <text x="420" y="306" fill="#FFF8EC" font-family="Georgia, serif" font-size="10" font-weight="bold" text-anchor="middle">100%</text>
    <text x="420" y="320" fill="#FFF8EC" font-family="sans-serif" font-size="9" text-anchor="middle">ORIGINAL</text>
  </svg>
</div>

<style>
  .cat-illustration-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cat-svg {
    width: 100%;
    max-width: 480px;
    height: auto;
    filter: drop-shadow(4px 6px 0px #49382F);
  }
</style>
