---
import { TECH_SPECS } from '../data/techSpecs';
---

<section id="tech" class="section tech-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">TECHNICAL ARCHITECTURE & SPECIFICATIONS</span>
      <h2 class="section-title">肯の基 Kendeji 线路与传输技术说明</h2>
      <p class="section-desc">
        以下数据来源于第三方公开讨论与资料收集。本站对各项出境线路、传输协议及兼容性进行了客观分类。
      </p>
    </div>

    <div class="tech-grid">
      {TECH_SPECS.map((spec) => (
        <div class="tech-card">
          <div class="tech-card-header">
            <span class="tech-cat">{spec.category}</span>
            <span class={`status-badge ${
              spec.status === '客户端支持' ? 'badge-sage' : 
              spec.status === '公开参考' ? 'badge-apricot' : 'badge-orange'
            }`}>
              {spec.status}
            </span>
          </div>

          <h3 class="tech-name font-serif">{spec.name}</h3>
          <p class="tech-desc">{spec.description}</p>
          <div class="tech-detail">
            <strong>技术特点：</strong>{spec.detail}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-section {
    background-color: var(--bg-card);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .tech-card {
    background-color: var(--bg-cream);
    border: 2px solid var(--color-cocoa);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-magazine-sm);
    display: flex;
    flex-direction: column;
  }

  .tech-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .tech-cat {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .status-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-dark);
  }

  .status-badge.badge-orange {
    background-color: var(--color-orange);
    color: #FFFFFF;
  }

  .status-badge.badge-apricot {
    background-color: var(--color-apricot);
    color: var(--color-cocoa);
  }

  .status-badge.badge-sage {
    background-color: var(--color-sage);
    color: #FFFFFF;
  }

  .tech-name {
    font-size: 1.2rem;
    color: var(--color-cocoa);
    margin-bottom: 0.5rem;
  }

  .tech-desc {
    font-size: 0.88rem;
    color: var(--color-text-dark);
    line-height: 1.5;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .tech-detail {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    line-height: 1.45;
  }

  .tech-detail strong {
    color: var(--color-cocoa);
  }
</style>
